using Gtk 4.0;
using Adw 1;

template $SandboxDialog: Adw.Window {
  modal: true;
  deletable: true;
  default-width: 550;
  title: _("Sandbox Settings");

  ShortcutController {
    Shortcut {
      trigger: "Escape";
      action: "action(window.close)";
    }
  }

  Box {
    orientation: vertical;

    Adw.HeaderBar {}

    Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Hardware & Resources");
        description: _("Configure resource access for the native Bubblewrap sandbox.");

        Adw.ActionRow {
          title: _("Share GPU");
          subtitle: _("Expose Mesa, Vulkan ICDs, and graphics devices for 3D acceleration");
          activatable-widget: switch_gpu;

          Switch switch_gpu {
            valign: center;
          }
        }

        Adw.ActionRow {
          title: _("Share Sound");
          subtitle: _("Expose PipeWire and PulseAudio sound sockets");
          activatable-widget: switch_sound;

          Switch switch_sound {
            valign: center;
          }
        }

        Adw.ActionRow row_input {
          title: _("Share Input Devices");
          subtitle: _("Programs in this bottle can read controllers and global keystrokes while enabled.");
          activatable-widget: switch_input;

          Switch switch_input {
            valign: center;
          }
        }

        Adw.ActionRow row_usb {
          title: _("Share USB Devices");
          subtitle: _("Programs in this bottle can access raw USB devices permitted by the host while enabled.");
          activatable-widget: switch_usb;

          Switch switch_usb {
            valign: center;
          }
        }
      }

      Adw.PreferencesGroup group_hidraw {
        title: _("Flight Controllers (HIDRAW)");
        description: _("Use raw HID access only for the selected vendor and product IDs.");
      }
    }
  }
}
